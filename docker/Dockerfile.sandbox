# ─────────────────────────────────────────────────────────────────────────────
# Sandbox image for abench container runs (opencode.sandbox.mode = "container").
#
# Carries the toolchain + opencode + a PRE-WARMED, WRITABLE Gradle cache — but
# NEVER the original/reference solution. The agent sees only the bind-mounted run
# workdir, so it cannot read the solution off disk. Verify still runs on the host.
#
# WHY the cache is BAKED IN (not mounted): a read-only `…/.gradle:ro` mount makes
# `./gradlew` fail — the wrapper must WRITE its lock + unpack the distribution
# (observed: `/root/.gradle/wrapper/dists/…/gradle-8.14-bin.zip.lck (Read-only
# file system)`), so the agent can't run tests and falls back to hand-compiling
# (→ false "all tests pass"). A baked WRITABLE warm cache means `./gradlew test`
# works fully offline with ZERO per-run config — UI-launched experiments "just
# work" and the agent gets a real, trustworthy test loop. No cache_mounts / no
# GRADLE_* env needed in the experiment.
#
# Build (from repo root; network required AT BUILD time to warm the cache):
#   docker build -t abench-sandbox:latest -f docker/Dockerfile.sandbox .
# Then set in the experiment:  opencode.sandbox.mode: container
# JDK is 21 to match the host verify (so the agent's in-container test results
# match the final verdict — no JDK-version confound).
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: warm the Gradle cache. Network is ON; this stage is DISCARDED. ──
# Built against the STRIPPED fixture (the stub, NOT the solution), so even the
# transient build context carries no reference code. COMPILING its tests
# (testClasses — we do NOT run them) downloads the wrapper distribution, every
# plugin, and the compile/test dependencies across all picocli modules. The
# final image copies only the resulting ~/.gradle, with the build cache stripped
# so no compiled task output (which could embed code) can ride along.
FROM eclipse-temurin:21-jdk AS gradle-warm
# Build-time proxy for isolated hosts. ARG (not ENV) → used only during build, never
# baked into the runtime image; scripts/setup_check.py fills it from the host's proxy
# env. Predefined HTTP(S)_PROXY build-args reach apt/curl/npm automatically; Gradle's
# JVM (wrapper download + deps) needs these sysprops, hence JAVA_TOOL_OPTIONS.
ARG JAVA_TOOL_OPTIONS
ENV DEBIAN_FRONTEND=noninteractive
# When building behind a CONNECT-only proxy (plain http/:80 blocked, https/:443
# tunnelled), switch apt's Ubuntu mirrors to https so fetches go through the proxy.
# Guarded on a proxy being set → a direct build is completely unchanged.
# Corporate/custom root CAs FIRST — so the HTTPS apt mirrors below AND Gradle's JVM
# downloads (wrapper distribution + Maven Central) trust a TLS-intercepting proxy
# (e.g. a corporate WSL2 host). MUST precede apt: an HTTPS apt behind a MITM proxy
# fails "certificate verify failed" until this CA is in the store. No-op when
# docker/extra-ca/ has no *.crt.
COPY docker/extra-ca/ /usr/local/share/ca-certificates/extra/
RUN update-ca-certificates && \
    for f in /usr/local/share/ca-certificates/extra/*.crt; do \
        [ -e "$f" ] || continue; \
        keytool -importcert -noprompt -cacerts -storepass changeit \
            -alias "extra-$(basename "$f")" -file "$f" || true; \
    done
# THEN apt — with the corporate CA already trusted, switching apt to HTTPS mirrors
# (for a CONNECT-only proxy where plain http/:80 is blocked) verifies cleanly.
RUN if [ -n "${HTTPS_PROXY}${https_proxy}" ]; then \
      sed -i -E 's#http://(archive|security)\.ubuntu\.com#https://\1.ubuntu.com#g' \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends git unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY experiments/picocli-putValue/stripped/ /warm/
WORKDIR /warm
# Warm the cache by COMPILING (not running) main + every module's tests:
# `testClasses` downloads the wrapper distribution, all plugins, and the
# compile/test dependency jars. We must NOT run `test` — the stub throws, so
# tests would FAIL and abort the image build; `testClasses` on the stub compiles
# cleanly and exits 0. Any test-runtime-only dep downloads at run time (the
# container has network). --no-build-cache so no compiled task output is cached;
# then drop the daemon + any residual build cache so nothing that could embed
# code rides into the final image.
# Keep this ONE shell line — no inline '#' comments inside a RUN, they interact
# badly with '\' continuations (that mangled the previous attempt).
RUN chmod +x ./gradlew \
    && git init -q && git add -A \
    && git -c user.email=warm@local -c user.name=warm commit -qm warm \
    && ./gradlew --no-daemon --no-build-cache testClasses \
    && rm -rf /root/.gradle/caches/build-cache-* /root/.gradle/daemon /root/.gradle/.tmp /root/.gradle/notifications

# ── Stage 2: the sandbox image (toolchain + opencode + the warm cache). ──
FROM eclipse-temurin:21-jdk

# Build-time proxy (ARG, not ENV → never baked into the runtime image). See the
# gradle-warm stage above; setup_check.py passes it from the host's proxy env.
ARG JAVA_TOOL_OPTIONS
ENV DEBIAN_FRONTEND=noninteractive

# Corporate/custom root CAs FIRST (private registry / internal mirror / TLS-
# intercepting proxy): drop PEM files into docker/extra-ca/ before building
# (gitignored; neutral names). Registered for the system store (curl/git/apt), the
# JVM keystore (gradle/maven), and Node (opencode). MUST precede apt so the HTTPS
# apt mirrors below verify a proxy-intercepted TLS chain. No-op when empty.
COPY docker/extra-ca/ /usr/local/share/ca-certificates/extra/
RUN update-ca-certificates && \
    n=0; for f in /usr/local/share/ca-certificates/extra/*.crt; do \
        [ -e "$f" ] || continue; n=$((n+1)); \
        keytool -importcert -noprompt -cacerts -storepass changeit \
            -alias "extra-ca-$n" -file "$f"; \
    done; echo "[extra-ca] registered $n extra cert(s)"
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
# THEN apt — corporate CA already trusted, so the HTTPS mirror switch verifies.
# ripgrep is here on purpose: opencode downloads its own rg from GitHub Releases at
# RUN time when none is on PATH ("downloading ripgrep …-x86_64-unknown-linux-musl"),
# which is one more per-run network dependency inside something measured in seconds —
# and one more thing for an authenticating proxy to refuse.
RUN if [ -n "${HTTPS_PROXY}${https_proxy}" ]; then \
      sed -i -E 's#http://(archive|security)\.ubuntu\.com#https://\1.ubuntu.com#g' \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        curl git unzip ca-certificates maven python3 ripgrep \
    && rm -rf /var/lib/apt/lists/*

# System Gradle for projects that ship NO wrapper. picocli uses its own
# ./gradlew, whose distribution is already in the baked cache copied below.
ARG GRADLE_VERSION=8.7
# Where to fetch the distribution from. Point it at a local/company mirror when the
# public host is slow or gets cut off — `GRADLE_DIST_BASE=https://mirror.example/gradle
# python scripts/setup_check.py --container --build-image` is enough; nothing else
# changes. Declared in THIS stage only: adding an ARG to the gradle-warm stage would
# invalidate its layer and re-run the ten-minute dependency warm-up for nothing.
ARG GRADLE_DIST_BASE=https://services.gradle.org/distributions
# ~130MB in one stream. An intercepting corporate proxy routinely drops a transfer
# that large mid-flight — `curl: (56) unexpected eof while reading` — and a single
# -fsSL turns that into a failed build after everything before it succeeded. Retry
# with RESUME (-C -), so each attempt continues from the bytes already on disk
# instead of starting the 130MB over, and verify the archive before unpacking so a
# truncated download reports itself rather than surfacing as a confusing unzip error.
RUN for i in 1 2 3 4 5; do \
        curl -fSL -C - --retry 3 --retry-delay 5 \
            "${GRADLE_DIST_BASE}/gradle-${GRADLE_VERSION}-bin.zip" \
            -o /tmp/gradle.zip && break; \
        echo "[gradle] download attempt $i failed — resuming in 5s"; sleep 5; \
    done \
    && unzip -tq /tmp/gradle.zip \
    && unzip -q /tmp/gradle.zip -d /opt \
    && ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle \
    && rm /tmp/gradle.zip

# Node + opencode CLI. Adjust this to however you install opencode if the
# package/install method differs in your environment.
#
# nodesource ships Node as one 32MB .deb, and an intercepting proxy that cannot carry
# a transfer that size times out mid-download — apt retries and then fails the build.
# So: generous apt retries/timeouts first, and if nodesource still will not come
# through, fall back to Ubuntu's own nodejs+npm. The distro mirrors are reachable in
# exactly the environments where nodesource is not (they were answering "Hit:" in the
# same build that timed out here), and opencode only needs a Node 20+ runtime — not
# nodesource specifically.
RUN set -eu; \
    APT_OPTS="-o Acquire::Retries=10 -o Acquire::http::Timeout=180 -o Acquire::https::Timeout=180"; \
    if curl -fsSL --retry 3 --retry-delay 5 https://deb.nodesource.com/setup_20.x | bash - \
       && apt-get $APT_OPTS install -y --no-install-recommends nodejs; then \
        echo "[node] installed from nodesource"; \
    else \
        echo "[node] nodesource unreachable — falling back to the distro packages"; \
        rm -f /etc/apt/sources.list.d/nodesource.list; \
        apt-get $APT_OPTS update; \
        apt-get $APT_OPTS install -y --no-install-recommends nodejs npm; \
    fi; \
    node --version; \
    rm -rf /var/lib/apt/lists/*; \
    npm config set fetch-retries 5 fetch-retry-maxtimeout 120000; \
    npm install -g opencode-ai || curl -fsSL --retry 3 https://opencode.ai/install | bash; \
    export PATH="/root/.opencode/bin:$PATH"; \
    command -v opencode >/dev/null 2>&1 || { \
        echo "[opencode] NOT INSTALLED — npm and the install script both failed."; \
        echo "[opencode] Refusing to ship an image whose agent binary is missing:"; \
        echo "[opencode] the container would start and exit 127 with"; \
        echo "[opencode]   'No model response -- opencode exited with code 127'."; \
        exit 1; \
    }; \
    opencode --version
ENV PATH="/root/.opencode/bin:${PATH}"

# opencode keeps its own plugin dependency in ~/.config/opencode (package.json pinning
# @opencode-ai/plugin to the CLI's version, ~57MB of node_modules) and installs it in
# the background on first use. A container starts with that directory EMPTY, so every
# single run re-installs it from the npm registry — which behind an authenticating
# proxy logs "background dependency install failed … 407" on each run. Nothing about a
# benchmark run should be installing packages; bake it once, here.
# Non-fatal: opencode logs this at WARN and keeps working, so a build that cannot reach
# the registry should still produce a usable image rather than fail outright.
RUN set -eu; \
    mkdir -p /root/.config/opencode; \
    ver="$(opencode --version 2>/dev/null | tr -d '\r\n' | tail -n1)"; \
    printf '{\n  "dependencies": {\n    "@opencode-ai/plugin": "%s"\n  }\n}\n' "$ver" \
        > /root/.config/opencode/package.json; \
    if (cd /root/.config/opencode && npm install --no-audit --no-fund) \
       && [ -d /root/.config/opencode/node_modules/@opencode-ai/plugin ]; then \
        echo "[opencode] plugin dependency baked in for $ver"; \
    else \
        echo "[opencode] WARN could not pre-install the plugin — runs will retry it"; \
    fi

# opencode resolves model metadata from the models.dev catalog and caches it at
# ~/.cache/opencode/models.json. A container starts with an EMPTY cache, so every
# single run re-fetches it — and behind an authenticating proxy that request answers
# 407, which surfaces as a stream of "APIError Proxy Authentication Required" that
# looks like the model endpoint failing even though api.deepseek.com is fine.
# Seed it here, where the build-time proxy args apply. Non-fatal: a direct build with
# no catalog still produces a working image, it just fetches at runtime as before.
RUN mkdir -p /root/.cache/opencode \
    && (curl -fsSL https://models.dev/api.json -o /root/.cache/opencode/models.json \
        && echo "[models.dev] catalog seeded ($(wc -c < /root/.cache/opencode/models.json) bytes)" \
        || echo "[models.dev] WARN could not seed the catalog — runs will fetch it")

# Pre-warmed, WRITABLE Gradle cache (wrapper distribution + plugins + all
# compile/test dependency jars; NO sources, NO build cache). This is what lets
# `./gradlew test` run fully offline with no mount and no env — so the agent has
# a real test loop and UI runs need zero extra config.
COPY --from=gradle-warm /root/.gradle /root/.gradle

# Install GT's OpenCode tools at container start from the mounted GT (no-op if
# GT isn't mounted). Keeps GT the single source of truth — no vendored copy.
COPY docker/sandbox-entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
RUN chmod +x /usr/local/bin/sandbox-entrypoint.sh

# Shell `impact` CLI on PATH: models instinctively run `bash impact` rather than
# calling the opencode tool, so give them a real command. It reads the run's
# .opencode/impact.json + the uncommitted diff and prints the tests covering each
# changed method. Data-gated: inert (exits cleanly) when no .opencode/impact.json
# is present, so it does NOTHING in baseline/augmented runs (no overlay) — only
# the augmented-tool condition ships the config + .impact data, so the A/B holds.
COPY docker/impact_cli.py /usr/local/bin/impact
RUN chmod +x /usr/local/bin/impact

# ── Runtime evidence probe (spike) ─────────────────────────────────────────
# Build the Byte Buddy agent jar once and bake it + the gradle init script in,
# so the phased-runtime suite command can attach it to the forked Test JVM
# (-javaagent). Built with an isolated gradle-user-home so the agent's deps
# (Byte Buddy/JUnit) don't pollute the baked picocli warm cache copied above.
COPY docker/runtime-probe /opt/runtime-probe-src
# Build the bootstrap Recorder FIRST (the agent's CorridorAdvice compiles against it,
# compileOnly), then the agent jar. The Recorder is JDK-only / NO Byte Buddy — it is
# appended to the bootstrap loader at run time (-Xbootclasspath/a) for chain mode, so
# advice inlined into picocli classes can resolve it across classloaders.
RUN cd /opt/runtime-probe-src/recorder \
    && gradle --no-daemon --gradle-user-home /tmp/probe-gradle jar \
    && cd /opt/runtime-probe-src \
    && gradle --no-daemon --gradle-user-home /tmp/probe-gradle jar \
    && mkdir -p /opt/runtime-probe \
    && cp build/libs/runtime-probe-agent.jar /opt/runtime-probe/agent.jar \
    && cp recorder/build/libs/runtime-probe-recorder.jar /opt/runtime-probe/recorder.jar \
    && cp probe-init.gradle /opt/runtime-probe/probe-init.gradle \
    && rm -rf /opt/runtime-probe-src /tmp/probe-gradle
ENV RUNTIME_PROBE_JAR=/opt/runtime-probe/agent.jar
ENV RUNTIME_PROBE_RECORDER=/opt/runtime-probe/recorder.jar
ENV RUNTIME_PROBE_INIT=/opt/runtime-probe/probe-init.gradle

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint.sh"]
