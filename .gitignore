.venv/
__pycache__/
*.pyc
runs/
.pytest_cache/
.idea

# Git worktrees for feature work (never tracked).
.worktrees/

# Heavy experiment artefacts (your project copies; never committed).
# Tracked-by-git parts of an experiment are: experiment.yaml, prompts/, slices/.
experiments/*/original/
experiments/*/stripped/
experiments/*/gt-out/

# Brainstorming companion artefacts (mockups, UI state — per-session)
.superpowers/

# Web frontend build artefacts (sources). The SERVED bundle (abench_ui/static/)
# is intentionally COMMITTED so the server can run the UI via `git pull` without
# an npm build behind a corporate proxy.
web/node_modules
web/dist

experiments/*/overlays/impact-artifacts/.impact/

# Per-machine extra root CA certs for the sandbox image (never commit).
docker/extra-ca/*.crt

# machine-local library paths (never commit; per-machine)
.abench.local.json
