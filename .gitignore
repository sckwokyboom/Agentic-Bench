.venv/
__pycache__/
*.pyc
runs/
.pytest_cache/
.idea

# Git worktrees for feature work (never tracked).
.worktrees/

# Heavy experiment artefacts (your project copies; never committed).
# Tracked-by-git parts of an experiment are: experiment.yaml, prompts/, slices/.
experiments/*/original/
experiments/*/stripped/
experiments/*/gt-out/

# Brainstorming companion artefacts (mockups, UI state — per-session)
.superpowers/

# Web frontend build artefacts
web/node_modules
web/dist
abench_ui/static/

experiments/*/overlays/impact-artifacts/.impact/

# Per-machine corporate/AV root CAs for the sandbox image (never commit).
docker/extra-ca/*.crt

# machine-local library paths (never commit; per-machine)
.abench.local.json